ADMIN_PASSWORD=
CRON_SECRET=
CRON_DRY_RUN=false

# Supabase project "Zenfulcove kayaks":
# Project URL -> NEXT_PUBLIC_SUPABASE_URL
# Publishable key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# Secret key or legacy service_role key -> SUPABASE_SERVICE_ROLE_KEY
# Direct connection string -> DATABASE_URL (local migration helper only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional Upstash fallback names used by lib/kv.js:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

LODGIFY_API_KEY=
JOTFORM_API_KEY=
JOTFORM_EU=false
JOTFORM_BOOKING_CONFIRMATION_FIELD_ID=

SENDGRID_API_KEY=
# Check-in form marketing opt-ins are added to these lists (optional; skipped when blank)
SENDGRID_SMS_OPT_IN_LIST_ID=
SENDGRID_EMAIL_OPT_IN_LIST_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_EVENTS_FROM_NUMBER=
TWILIO_SKIP_SIGNATURE_CHECK=false

SALESMATE_DOMAIN=
SALESMATE_LINK_NAME=
SALESMATE_SESSION_KEY=
SALESMATE_OWNER_ID=

# Stripe Checkout for paid/additional rentals.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe mode for kayaks/commerce (test|live). In-cabin massage has its own
# independent switch so it can stay in test while these run live.
KAYAK_STRIPE_MODE=
MASSAGE_STRIPE_MODE=
# Optional for future embedded Stripe UI; hosted Checkout does not require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Public app URL used for Stripe success/cancel redirects in production.
NEXT_PUBLIC_SITE_URL=

# In-Cabin Massage availability/calendar. Google service account that the
# therapist shares her calendar with (view free/busy + make changes to events).
# Paste the service account's client_email and private_key (keep the \n escapes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Secret for the In-Cabin Massage preview bypass: visiting /spa?preview=<secret>
# unlocks the feature for testing while it stays hidden from regular guests.
SPA_PREVIEW_SECRET=
